# =========================================================
# Variables de entorno - Parcial 2: Despliegue multi-contenedor
# Opcional: docker-compose.yml ya usa estos mismos valores por defecto.
# Para cambiarlos, copia este archivo como ".env" y edítalo:
#   cp .env.example .env
# =========================================================

# ---- PostgreSQL ----
POSTGRES_DB=joomladb
POSTGRES_USER=joomla_user
POSTGRES_PASSWORD=joomla_pass_123
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ---- Joomla ----
JOOMLA_DB_HOST=database
JOOMLA_DB_TYPE=pgsql
JOOMLA_DB_NAME=${POSTGRES_DB}
JOOMLA_DB_USER=${POSTGRES_USER}
JOOMLA_DB_PASSWORD=${POSTGRES_PASSWORD}
JOOMLA_SITE_NAME=Portal Institucional - Parcial COMM
JOOMLA_ADMIN_USER=Administrador Parcial
JOOMLA_ADMIN_USERNAME=admin
JOOMLA_ADMIN_PASSWORD=AdminParcial123!
JOOMLA_ADMIN_EMAIL=admin@parcial.local

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
# Lectura anónima de los dashboards (rol Viewer); para editar, iniciar sesión como admin
GF_AUTH_ANONYMOUS_ENABLED=true

# ---- Jupyter ----
# Vacío = acceso sin token (por defecto). Escribe un valor para exigir token al entrar.
JUPYTER_TOKEN=
