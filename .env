# =========================================================
# Variables de entorno - Parcial 2: Despliegue multi-contenedor
# Copiar este archivo como ".env" antes de levantar el stack:
#   cp .env.example .env
# =========================================================

# ---- PostgreSQL ----
POSTGRES_DB=joomladb
POSTGRES_USER=joomla_user
POSTGRES_PASSWORD=joomla_pass_123
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ---- Joomla ----
JOOMLA_DB_HOST=database
JOOMLA_DB_TYPE=pgsql
JOOMLA_DB_NAME=${POSTGRES_DB}
JOOMLA_DB_USER=${POSTGRES_USER}
JOOMLA_DB_PASSWORD=${POSTGRES_PASSWORD}
JOOMLA_SITE_NAME=Portal Institucional - Parcial COMM

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true

# ---- Jupyter ----
JUPYTER_TOKEN=parcial123
