{
  "uid": "joomla-logs",
  "title": "Tráfico HTTP y logs — Nginx / Joomla",
  "description": "Logs de acceso de Nginx y de Apache (Joomla) leídos desde PostgreSQL (file_fdw).",
  "tags": [
    "parcial-comm",
    "nginx",
    "joomla",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "PostgreSQL",
      "type": "dashboards",
      "tags": [
        "parcial-comm"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "servicio",
