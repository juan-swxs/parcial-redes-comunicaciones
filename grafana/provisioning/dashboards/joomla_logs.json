{
  "id": null,
  "uid": "joomla-activity",
  "title": "Actividad Joomla / PostgreSQL - Parcial COMM",
  "tags": ["parcial", "comm", "joomla", "postgresql"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Conexiones activas a PostgreSQL (proxy de tráfico HTTP hacia Joomla)",
      "description": "Cuenta total de conexiones abiertas contra la base de datos en este momento.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-joomla" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-joomla" },
          "format": "table",
          "rawSql": "SELECT count(*) AS conexiones FROM pg_stat_activity WHERE datname = current_database();",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 12 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Distribución de escrituras (INSERT/UPDATE) por tabla",
      "description": "Qué tablas de Joomla concentran la actividad generada por el tráfico del CMS.",
      "gridPos": { "h": 9, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-joomla" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-joomla" },
          "format": "table",
          "rawSql": "SELECT relname AS tabla, (n_tup_ins + n_tup_upd) AS escrituras FROM pg_stat_user_tables WHERE (n_tup_ins + n_tup_upd) > 0 ORDER BY escrituras DESC LIMIT 8;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^escrituras$/", "values": true },
        "pieType": "donut",
        "displayLabels": [],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Detalle de sesiones activas en PostgreSQL (estado, aplicación, tiempo de consulta)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "postgres", "uid": "postgres-joomla" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-joomla" },
          "format": "table",
          "rawSql": "SELECT pid, COALESCE(host(client_addr),'local') AS ip, application_name, state, query_start, LEFT(query, 80) AS ultima_consulta FROM pg_stat_activity WHERE datname = current_database() ORDER BY query_start DESC;",
          "refId": "A"
        }
      ]
    }
  ]
}
