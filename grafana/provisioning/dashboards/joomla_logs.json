          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), percentile_cont(0.5) WITHIN GROUP (ORDER BY request_time) * 1000 AS \"p50\", percentile_cont(0.95) WITHIN GROUP (ORDER BY request_time) * 1000 AS \"p95\", max(request_time) * 1000 AS \"máx.\" FROM monitoring.nginx_access WHERE $__timeFilter(ts) AND servicio IN ($servicio) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
